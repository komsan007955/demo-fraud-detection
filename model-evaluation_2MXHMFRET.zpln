{
  "paragraphs": [
    {
      "title": "",
      "text": "%pyspark\n# import libraries\nimport pyspark.sql.functions as F\nimport pyspark.sql.types import T\nfrom pyspark.ml.evaluation import MulticlassClassificationEvaluator\nfrom datetime import datetime, timedelta\n\n# prepare datetime\ndt_now \u003d datetime.now()\nfmt_pdate \u003d lambda dt: long(dt.strftime(\"%Y%m%d\"))\n\ndf_label \u003d spark.sql(f\"select * from fraud_label where partition_date \u003d {fmt_pdate(dt_now - timedelta(days\u003d1))}\") # read labeled data\ndf_label.write.insertInto(\"fraud_train_clean\") # add labeled data into train data\n\ndf_pred \u003d spark.sql(f\"select * from fraud_pred where partition_date \u003d {fmt_pdate(dt_now - timedelta(days\u003d1))}\") # read predicted data\ndf_join \u003d df_label.join(df_pred, df_label.transaction_id \u003d\u003d df_pred.transaction_id, \"inner\") # join labeled data and predicted data to compare labels\n\nprecision \u003d MulticlassClassificationEvaluator(metricName\u003d\"weightedPrecision\").evaluate(df_join) # calculate precision\nrecall \u003d MulticlassClassificationEvaluator(metricName\u003d\"weightedRecall\").evaluate(df_join) # calculate recall\nf1_score \u003d MulticlassClassificationEvaluator().evaluate(df_join) # calculate F1 score\n\n# prepare performance data\ndata \u003d [[precision, recall, f1_score, dt_now, fmt_pdate(dt_now)]]\n\nschema \u003d T.StructType([\n    T.StructField(\"precision\", T.DoubleType(), True), \n    T.StructField(\"recall\", T.DoubleType(), True), \n    T.StructField(\"f1_score\", T.DoubleType(), True), \n    T.StructField(\"timestamp\", T.DoubleType(), True), \n    T.StructField(\"partition_date\", T.DoubleType(), True)\n])\n\ndf_perf \u003d spark.createDataFrame(data, schema) # create performance table\ndf_perf.write.insertInto(\"fraud_perf\") # append data into fraud_perf",
      "user": "anonymous",

      "title": "",
      "text": "%pyspark\nimport os, blendata_util, mlflow\nfrom datetime import datetime, timedelta\nimport pyspark.sql.functions as F\nimport pyspark.sql.types import T\n\nos.environ[\"MLFLOW_TRACKING_URI\"] \u003d \"XXXXXXXXXXXXXXXXXX\"\nos.environ[\"MLFLOW_TRACKING_USERNAME\"] \u003d blendata_util.getUser()\nos.environ[\"MLFLOW_TRACKING_PASSWORD\"] \u003d \"XXXXXXXXXXXX\"\ndfs_tmpdir \u003d \"/bdedatastore/zeus/tmp\"\n\nmlflow.set_workspace(\"komsan-workspace\")\n\ndt_now \u003d datetime.now()\nfmt_pdate \u003d lambda dt: long(dt.strftime(\"%Y%m%d\"))\n\ndf \u003d spark.sql(f\"select * from fraud_inference where partition_date \u003d {fmt_pdate(dt_now - timedelta(days\u003d1))}\")\n\nmodel_uri \u003d \"models:\" + \"/\".join[\"\", \"demo-fraud\", \"latest\"]\nmodel \u003d mlflow.spark.load_model(model_uri, dfs_tmpdir\u003ddfs_tmpdir)\ndf_pred \u003d model.transform(df)\n\ndf_pred \u003d df_pred.withColumns({\n    \"pred_timestamp\": lit(dt_now), \n    \"partition_date\": lit(pdate_now)\n    }) \\\n    .drop(\"features\")\n\ndf_pred.write.insertInto(\"fraud_pred\")",

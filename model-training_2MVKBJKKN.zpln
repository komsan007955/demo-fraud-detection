    {
      "text": "%pyspark\nimport mlflow\n\nmlflow.set_workspace(\"komsan-workspace\")\nmlflow.set_experiment(\"demo-fraud-detection\")\nmlflow.pyspark.ml.autolog(log_models\u003dFalse)\n\ndef train_model(model, param_grid, run_name, cv_evaluator\u003dbce, cv_num_folds\u003d3, mlflow_artifact_path\u003d\"estimator\"):\n    pl_stages_wmodel \u003d pl_stages + [model]\n    pl \u003d Pipeline(stages\u003dpl_stages_wmodel)\n\n    with mlflow.start_run(run_name\u003drun_name) as run:\n        cv \u003d CrossValidator(\n            estimator\u003dmodel, \n            estimatorParamMaps\u003dparam_grid, \n            evaluator\u003dcv_evaluator, \n            numFolds\u003dcv_num_folds\n        )\n        \n        cv_model \u003d cv.fit(df)\n        best_model \u003d cv_model.bestModel\n        mlflow.spark.log_model(best_model, artifact_path\u003dmlflow_artifact_path, dfs_tmpdir\u003ddfs_tmpdir)\n        \n        run_id \u003d mlflow.active_run().info.run_id\n        highest_score \u003d max(cv_model.avgMetrics)\n        return [run_id, highest_score]\n\nruns_rec \u003d []",
      "user": "anonymous",
      "dateUpdated": "2026-07-29 14:43:34.067",
      "progress": 0,
      "config": {
        "lineNumbers": true,

    {
      "title": "",
      "text": "%pyspark\nimport pyspark.sql.functions as F\nimport pyspark.sql.types import T\nfrom pyspark.ml import Pipeline\nfrom pyspark.ml.feature import StringIndexer, OneHotEncoder, VectorAssembler, MinMaxScaler\nfrom pyspark.ml.evaluation import BinaryClassificationEvaluator\nfrom pyspark.ml.tuning import CrossValidator, CrossValidatorModel, ParamGridBuilder\nimport os, blendata_util\n\nos.environ[\"MLFLOW_TRACKING_URI\"] \u003d \"XXXXXXXXXXXXXXXXXX\"\nos.environ[\"MLFLOW_TRACKING_USERNAME\"] \u003d blendata_util.getUser()\nos.environ[\"MLFLOW_TRACKING_PASSWORD\"] \u003d \"XXXXXXXXXXXX\"\ndfs_tmpdir \u003d \"/bdedatastore/zeus/tmp\"\n\ndf \u003d spark.sql(\"select * from fraud_train_clean\")\ndf \u003d df.withColumn(\"label\", F.col(\"fraud\").cast(T.DoubleType()))\n\ncols_si_in \u003d [\"transaction_type\", \"merchant_category\", \"country\"]\ncols_si_out \u003d [f\"{c}_idx\" for c in cols_str_in]\ncols_ohe_out \u003d [f\"{c}_enc\" for c in cols_str_in]\ncols_va_mms_in \u003d [\"amount\", \"device_risk_score\", \"ip_risk_score\"]\ncol_va_mms_out \u003d \"features_to_scale\"\ncol_mms_out \u003d \"features_scaled\"\ncols_va_in \u003d cols_ohe_out + col_mms_out + [\"hour\"]\n\nsi \u003d StringIndexer(inputCols\u003dcols_si_in, outputCols\u003dcols_si_out)\nohe \u003d OneHotEncoder(inputCols\u003dcols_si_out, outputCols\u003dcols_ohe_out)\nva_mms \u003d VectorAssembler(inputCols\u003dcols_va_mms_in, outputCol\u003dcol_va_mms_out)\nmms \u003d MinMaxScaler(inputCol\u003dcol_va_mms_out, outputCol\u003dcol_mms_out)\nva \u003d VectorAssembler(inputCols\u003dcols_va_in, outputCol\u003d\"features\")\n\npl_stages \u003d [si, ohe, va_mms, mms, va]\n\nbce \u003d BinaryClassificationEvaluator()",
      "user": "anonymous",
      "dateUpdated": "2026-07-29 14:43:30.315",
      "progress": 0,
      "config": {

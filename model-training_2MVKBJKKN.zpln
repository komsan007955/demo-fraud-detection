    {
      "text": "%pyspark\nfrom pyspark.ml.evaluation import BinaryClassificationEvaluator\nfrom pyspark.ml.tuning import CrossValidator, CrossValidatorModel, ParamGridBuilder\nfrom pyspark.ml.classification import RandomForestClassifier\n\nrfc \u003d RandomForestClassifier()\n\npg_rfc \u003d ParamGridBuilder() \\\n    .addGrid(rfc.maxDepth, [2, 5, 10]) \\\n    .addGrid(rfc.maxBins, [16, 32, 64]) \\\n    .addGrid(rfc.numTrees, [10, 20, 40]) \\\n    .build()\n\ncv_rfc \u003d CrossValidator(\n    estimator\u003drfc, \n    estimatorParamMaps\u003dpg_rfc, \n    evaluator\u003dBinaryClassificationEvaluator(), \n    numFolds\u003d3\n)\n\ncv_rfc_md \u003d cv_rfc.fit(df_train)\nsave_path_cv_rfc \u003d f\"{model_reg_path}/{dt_now_str}/RandomForestClassifier\"\ncv_rfc_md.write().overwrite().save(save_path_cv_rfc)\n\ncv_rfc_load \u003d CrossValidatorModel.load(save_path_cv_rfc)\ncv_rfc_load.bestModel, max(cv_rfc_load.avgMetrics)",
      "user": "anonymous",
      "dateUpdated": "2026-06-12 15:37:18.783",
      "progress": 0,

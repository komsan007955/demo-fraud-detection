    {
      "text": "%pyspark\nfrom pyspark.ml.classification import RandomForestClassifier\n\nrfc \u003d RandomForestClassifier()\n\npg_rfc \u003d ParamGridBuilder() \\\n    .addGrid(rfc.maxDepth, [2, 5, 10]) \\\n    .addGrid(rfc.maxBins, [16, 32, 64]) \\\n    .addGrid(rfc.numTrees, [10, 20, 40]) \\\n    .build()\n\nrun_result \u003d train_model(rfc, pg_rfc, \"RandomForestClassifier\")\nruns_rec.append(run_result)\n\n\nfrom pyspark.ml.classification import GBTClassifier\n\ngbtc \u003d GBTClassifier()\n\npg_gbtc \u003d ParamGridBuilder() \\\n    .addGrid(gbtc.maxDepth, [2, 5, 10]) \\\n    .addGrid(gbtc.maxBins, [16, 32, 64]) \\\n    .build()\n\nrun_result \u003d train_model(gbtc, pg_gbtc, \"GBTClassifier\")\nruns_rec.append(run_result)",
